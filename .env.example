# ===== Bartender Configuration =====

# ──────────────────────────────────────────────────────────────────────
# LLM — Fallback chain (tried in order; skips providers with no key)
#   openai → gemini → grok → github (Claude) → local llama.cpp
# ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_FALLBACK_CHAIN=openai,gemini,grok,github,local

# OpenAI (primary)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Google Gemini (backup 1)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-pro

# Grok / xAI (backup 2 — free tier available at console.x.ai)
GROK_API_KEY=xai-your-key-here
GROK_MODEL=grok-3

# GitHub Models → Claude (optional — needs a GitHub PAT with `models` scope)
# Routes through Copilot's access to Claude via models.github.ai
GITHUB_TOKEN=
GITHUB_MODEL=anthropic/claude-sonnet-4-20250514

# ──────────────────────────────────────────────────────────────────────
# Offline / Local LLM  (llama.cpp — final fallback & explicit offline)
# ──────────────────────────────────────────────────────────────────────
LOCAL_MODEL_PATH=
LOCAL_MODEL_N_CTX=4096
LOCAL_MODEL_N_GPU_LAYERS=0
OFFLINE_FALLBACK=true

# ──────────────────────────────────────────────────────────────────────
# Speech / TTS
# ──────────────────────────────────────────────────────────────────────
TTS_SPEED=0.55
TTS_VOICE=nova
SILENCE_THRESHOLD_SECONDS=2.0
WAKE_WORD=hey bartender
SECTION_PAUSE_SECONDS=5.0

# ──────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
SERVER_URL=http://192.168.1.100:8080

# ──────────────────────────────────────────────────────────────────────
# RAG  (openai_vs = OpenAI Vector Stores | chromadb = local ChromaDB)
# ──────────────────────────────────────────────────────────────────────
RAG_BACKEND=openai_vs

# OpenAI Vector Stores (set in .env.local — IDs from platform.openai.com)
# OPENAI_VECTOR_ESSAY_EXEMPLARY=vs_...
# OPENAI_VECTOR_SOURCE=vs_...
# OPENAI_VECTOR_ESSAY_ATTACK=vs_...

# ChromaDB settings (used when RAG_BACKEND=chromadb)
CHROMA_PERSIST_DIR=./data/chromadb
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
